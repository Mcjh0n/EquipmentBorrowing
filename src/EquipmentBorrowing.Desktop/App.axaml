<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:EquipmentBorrowing.Desktop"
             x:Class="EquipmentBorrowing.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1F4E78" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="TextBlock.section-heading">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style Selector="TextBlock.status-message">
            <Setter Property="Foreground" Value="#1F4E78" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style Selector="Border.list-item">
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Application.Styles>
</Application>
