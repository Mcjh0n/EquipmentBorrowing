<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="12">
        <TextBlock Grid.Row="0"
                   Text="Available Equipment"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <Button Grid.Row="1"
                Content="Refresh Equipment"
                Command="{Binding LoadCommand}"
                HorizontalAlignment="Left" />

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding AvailableEquipment}"
                 SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:Equipment">
                    <Border Padding="12"
                            Margin="0,4"
                            Background="#F7F9FC"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="70,*,120">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Id}"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding IsAvailable}"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
