<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Campus Equipment Borrowing System"
        Width="1000"
        Height="650"
        MinWidth="800"
        MinHeight="500">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="#1F4E78"
                Padding="24,16">
            <TextBlock Text="Campus Equipment Borrowing System"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="White" />
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="220,*">
            <Border Grid.Column="0"
                    Background="#F2F4F7"
                    Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Navigation"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Button Content="Equipment"
                            Command="{Binding ShowEquipmentCommand}"
                            HorizontalAlignment="Stretch" />

                    <Button Content="Active Borrowings"
                            Command="{Binding ShowBorrowingsCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="28">
                <Grid RowDefinitions="Auto,Auto,*"
                      RowSpacing="16">
                    <TextBlock Grid.Row="0"
                               Text="{Binding CurrentSection}"
                               FontSize="26"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1"
                               Text="{Binding CurrentSectionDescription}"
                               FontSize="15"
                               TextWrapping="Wrap" />

                    <ContentControl Grid.Row="2"
                                    Content="{Binding CurrentView}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>