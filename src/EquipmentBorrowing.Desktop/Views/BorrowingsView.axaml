<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

    <StackPanel Spacing="12">
        <TextBlock Text="Active Borrowings"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <TextBlock Text="The active-borrowings list and Return Equipment button will be added in a later part."
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>