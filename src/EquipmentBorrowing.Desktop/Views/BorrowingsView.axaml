<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="12">
        <TextBlock Grid.Row="0"
                   Text="Active Borrowings"
                   Classes="section-heading" />

        <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="230" PlaceholderText="Search student number/name or equipment" Text="{Binding SearchText}" />
                <ComboBox Width="100" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" />
                <ComboBox Width="150" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortField}" />
                <CheckBox Content="Descending" IsChecked="{Binding SortDescending}" />
                <Button Content="Search" Command="{Binding SearchCommand}" Classes="primary" />
                <Button Content="Clear search" Command="{Binding ClearSearchCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox Width="180" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudentForHistory}" PlaceholderText="Student history" />
                <Button Content="Student history" Command="{Binding ShowStudentHistoryCommand}" />
                <ComboBox Width="180" ItemsSource="{Binding Equipment}" SelectedItem="{Binding SelectedEquipmentForHistory}" PlaceholderText="Equipment history" />
                <Button Content="Equipment history" Command="{Binding ShowEquipmentHistoryCommand}" />
                <Button Content="Refresh" Command="{Binding LoadCommand}" />
                <Button Content="Return selected" Command="{Binding ReturnEquipmentCommand}" Classes="primary" />
            </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding ActiveBorrowings}"
                 SelectedItem="{Binding SelectedBorrowing, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:Borrowing">
                    <Border Classes="list-item">
                        <Grid ColumnDefinitions="75,*,*,160,95">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Id}"
                                       FontWeight="SemiBold" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Student.Name}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Student"
                                           FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Equipment.Name}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Equipment"
                                           FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{Binding ExpectedReturnDate}" />
                                <TextBlock Text="Expected return"
                                           FontSize="12" />
                            </StackPanel>

                            <TextBlock Grid.Column="4"
                                       Text="{Binding Status}"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Classes="status-message" />
    </Grid>
</UserControl>
